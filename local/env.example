# opencode local model runner example.
# Copy to local/env.local and change only the values you need.

# Model id shown by your local server.
LOCAL_MODEL_ID=your-model-id

# Optional display name.
LOCAL_MODEL_NAME=Your model

# Supported backends:
# - ollama
# - llamacpp
# - vllm
# - mlx-lm
# - vmlx
# - omlx
# - vllm-metal
# - lmstudio
# - openai-compatible
LOCAL_BACKEND=ollama

# Optional override. Leave empty to use the backend default.
# Ollama:    http://127.0.0.1:11434/v1
# llama.cpp: http://127.0.0.1:8080/v1
# vLLM:      http://127.0.0.1:8000/v1
# mlx-lm:    http://127.0.0.1:8080/v1
# vMLX:      http://127.0.0.1:8000/v1
# omlx:      http://127.0.0.1:8001/v1
# vLLM Metal:http://127.0.0.1:8000/v1
# LM Studio: http://127.0.0.1:1234/v1
LOCAL_OPENAI_BASE_URL=

# Model id for opencode.
# Keep this slash-free because opencode uses provider/model syntax.
# For vLLM use --served-model-name with this alias.
# For llama.cpp use --alias with this alias.
# For mlx-lm, set this to the exact model id exposed by /v1/models if needed.

# Local servers often ignore the key but OpenAI-compatible clients still expect one.
LOCAL_API_KEY=local-dev-token

# opencode options.
# Leave empty: the launcher auto-detects packages/opencode/dist/opencode-<os>-<arch>/bin/opencode.
# Set it only to point at a different binary.
LOCAL_OPENCODE_BIN=

# Pin the session db so it does not change when you build on another branch.
# export OPENCODE_DB=opencode-dev.db
LOCAL_OPENCODE_PROVIDER_ID=local
