{
  "$schema": "https://opencode.ai/config.json",

  // Example only. scripts/opencode-local generates OPENCODE_CONFIG_CONTENT at runtime
  // so your global opencode.json does not need to change.
  "provider": {
    "local-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "local-dev-token"
      },
      "models": {
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B" },
        "qwen2.5-coder:3b": { "name": "Qwen2.5 Coder 3B" },
        "qwen2.5-coder:1.5b": { "name": "Qwen2.5 Coder 1.5B" }
      }
    },
    "local-openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OpenAI-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local-dev-token"
      },
      "models": {
        "gemma-4-e4b": { "name": "Gemma 4 E4B IT" },
        "gemma-4-e2b": { "name": "Gemma 4 E2B IT" },
        "qwen-coder-7b": { "name": "Qwen2.5 Coder 7B Instruct" },
        "qwen-coder-3b": { "name": "Qwen2.5 Coder 3B Instruct" },
        "qwen-coder-1.5b": { "name": "Qwen2.5 Coder 1.5B Instruct" }
      }
    }
  },

  "model": "local-ollama/qwen2.5-coder:7b"
}
