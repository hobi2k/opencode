#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck disable=SC1091
. "$ROOT/scripts/opencode-local-common.sh"

opencode_local_load_env "$ROOT"
opencode_local_profile
opencode_local_resolve_backend

PROVIDER_ID=${LOCAL_OPENCODE_PROVIDER_ID:-local}
PROVIDER_ID_JSON=$(opencode_local_json_escape "$PROVIDER_ID")
BASE_URL_JSON=$(opencode_local_json_escape "$LOCAL_RESOLVED_BASE_URL")
API_KEY_JSON=$(opencode_local_json_escape "$LOCAL_RESOLVED_API_KEY")
MODEL_JSON=$(opencode_local_json_escape "$LOCAL_RESOLVED_MODEL")
NAME_JSON=$(opencode_local_json_escape "$LOCAL_PROFILE_NAME")

OPENCODE_CONFIG_CONTENT=$(cat <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "model": "$PROVIDER_ID_JSON/$MODEL_JSON",
  "provider": {
    "$PROVIDER_ID_JSON": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local OpenAI-compatible",
      "options": {
        "baseURL": "$BASE_URL_JSON",
        "apiKey": "$API_KEY_JSON"
      },
      "models": {
        "$MODEL_JSON": {
          "name": "$NAME_JSON"
        }
      }
    }
  }
}
EOF
)

if [ "${1:-}" = "--print" ]; then
  opencode_local_print
  printf 'provider=%s\n' "$PROVIDER_ID"
  printf 'opencode_selector=%s/%s\n' "$PROVIDER_ID" "$LOCAL_RESOLVED_MODEL"
  printf '%s\n' "$OPENCODE_CONFIG_CONTENT"
  exit 0
fi

export OPENCODE_CONFIG_CONTENT

if [ -n "${LOCAL_OPENCODE_BIN:-}" ]; then
  exec "$LOCAL_OPENCODE_BIN" "$@"
fi

if [ -f "$ROOT/packages/opencode/src/index.ts" ] && command -v bun >/dev/null 2>&1; then
  exec bun run --cwd "$ROOT/packages/opencode" --conditions=browser ./src/index.ts "$@"
fi

exec opencode "$@"
